{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1",
      "maxDuration": 30
    },
    "api/ping.php": {
      "runtime": "vercel-php@0.7.1",
      "maxDuration": 10
    },
    "api.php": {
      "runtime": "vercel-php@0.7.1",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/ping",
      "destination": "/api/ping.php"
    },
    {
      "source": "/api.php",
      "destination": "/api/index.php"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.php"
    },
    {
      "source": "/api",
      "destination": "/api/index.php"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
