{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "^/api\\.php(.*)$",
      "dest": "/api/index.php$1"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/api$",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    }
  ]
}
